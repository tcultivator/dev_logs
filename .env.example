# MySQL via XAMPP (default: root with empty password)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=''
MYSQL_DATABASE=devlog

# NextAuth. Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google Cloud OAuth client (authorized redirect: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Free Gmail SMTP. Use a Google App Password, not your normal Gmail password.
# Leave SMTP_USER empty to print the code in the dev terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
